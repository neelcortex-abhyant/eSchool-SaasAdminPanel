# eSchool SaaS — Phase 9 canary reverse proxy (EXAMPLE)
#
# Default: all traffic → Laravel (port 8000).
# Allowlisted locations only → FastAPI (port 8001).
#
# Usage:
#   1. Copy to your gateway host config.
#   2. Populate allowlist paths from allowlist.empty.txt (one path prefix per line).
#   3. Reload nginx only after ownership matrix sign-off for those domains.
#   4. Rollback = empty the allowlist (or include allowlist.empty.txt) and reload.
#
# Never dual-write. Shadow reads are optional and must not mutate state.

upstream laravel_upstream {
    server 127.0.0.1:8000;
    keepalive 32;
}

upstream fastapi_upstream {
    server 127.0.0.1:8001;
    keepalive 32;
}

# Map allowlisted URI prefixes to "fastapi"; everything else stays "laravel".
# Keep this map empty (or commented) until a domain is approved for canary.
map $request_uri $eschool_upstream {
    default laravel;

    # --- BEGIN ALLOWLIST (examples; replace with signed domains) ---
    # ~*^/api/health(?:\?|$)          fastapi;
    # ~*^/api/get-languages(?:\?|/)   fastapi;
    # --- END ALLOWLIST ---
}

server {
    listen 443 ssl http2;
    server_name eschool-saas.wrteam.me;  # frozen public API host — confirm in baseline/FROZEN_ORIGINS.md

    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    # Reject responses that leak temporary FastAPI origins (defense in depth;
    # primary enforcement is in FastAPI APP_URL / media builders).
    # Adjust host patterns to match staging/temp FastAPI hostnames in your env.
    proxy_hide_header X-Powered-By;

    location / {
        set $proxy_pass_target http://laravel_upstream;

        if ($eschool_upstream = fastapi) {
            set $proxy_pass_target http://fastapi_upstream;
        }

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # Preserve client request id if present; else generate one at the edge.
        proxy_set_header X-Request-Id $request_id;

        # Critical: do not buffer/alter multipart (logins, uploads up to 50 MB).
        client_max_body_size 50m;
        proxy_request_buffering on;
        proxy_read_timeout 120s;

        proxy_pass $proxy_pass_target;
    }

    # Optional: dedicated health that can probe FastAPI without canarying clients.
    location = /__fastapi_health {
        proxy_pass http://fastapi_upstream/health;
        proxy_set_header Host $host;
        access_log off;
    }
}

# -----------------------------------------------------------------------------
# Prefer explicit location blocks for allowlisted paths when map+if is undesirable.
# Uncomment and duplicate per signed domain (reads first; writes only after ownership).
# -----------------------------------------------------------------------------
#
# location ^~ /api/get-languages {
#     proxy_http_version 1.1;
#     proxy_set_header Host $host;
#     proxy_set_header X-Real-IP $remote_addr;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
#     client_max_body_size 50m;
#     proxy_pass http://fastapi_upstream;
# }
#
# Default catch-all remains Laravel:
# location / {
#     proxy_pass http://laravel_upstream;
#     ...
# }
