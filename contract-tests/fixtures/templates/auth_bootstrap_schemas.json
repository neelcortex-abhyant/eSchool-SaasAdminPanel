    {
      "id": "A1",
      "name": "student_login_success",
      "method": "POST",
      "path": "/api/student/login",
      "encoding": "multipart",
      "auth": "none",
      "request_fields": ["gr_number", "password", "school_code", "fcm_id?"],
      "expect": {
        "http_status": 200,
        "body": {
          "error": false,
          "message": "string",
          "code": "number",
          "data": "UserDataResource complete graph",
          "token": "string id|plain"
        }
      },
      "golden_file": "fixtures/golden/student/login_success.json"
    },
