APP_NAME=eSchool SaaS
APP_ENV=local
APP_DEBUG=true
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
SESSION_SECRET=change-me
LOG_LEVEL=INFO

REDIS_URL=redis://127.0.0.1:6380/0
APP_URL=https://eschool-saas.wrteam.me
# Optional. Base hostname for default school subdomains (prefix.base).
# When blank, the hostname of APP_URL is used.
SCHOOL_BASE_DOMAIN=
ALLOW_DDL=false
POOL_SIZE=5
MAX_OVERFLOW=10

# Single Neon PostgreSQL for ALL APIs (/api/v1 + /api/student|/admin|...).
# Prefer postgresql+psycopg:// (psycopg v3). Bare postgresql:// is auto-normalized.
# Do NOT commit real secrets. School isolation uses school_id — not separate databases.
NEON_DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/eschool_saas_v1?sslmode=require
V1_SESSION_TTL_MINUTES=10080
# Optional: existing v1_users.email promoted to super_admin on app startup (no user creation).
V1_SUPER_ADMIN_EMAIL=

# Isolated Postgres used ONLY by pytest / intentional test migrations.
# Alembic ignores this unless ALLOW_TEST_MIGRATIONS=1 is also set.
# Example: same Neon host, different database name: .../eschool_saas_test?sslmode=require
TEST_DATABASE_URL=

# Razorpay subscription payments. Placeholders only; never commit real keys.
# Non-production APP_ENV accepts only rzp_test_ key ids; production accepts only rzp_live_.
# The key secret and webhook secret stay on the server and are never returned by the API.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
# Only INR is supported for order creation.
RAZORPAY_CURRENCY=INR

# Mail for School Admin invitations and password resets. Placeholders only.
# Nothing is sent unless SMTP_HOST, SMTP_FROM and ADMIN_RESET_URL are all set;
# the API then reports invite_sent=false instead of claiming a send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Admin panel reset page; the emailed link is ADMIN_RESET_URL?token=...
ADMIN_RESET_URL=https://admin.example.com/login/reset
PASSWORD_RESET_TTL_MINUTES=60
INVITE_TTL_MINUTES=4320

# Fernet key for school WhatsApp / fee-gateway / third-party secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty → school secret encrypt/decrypt returns 503.
SCHOOL_SECRETS_KEY=

# Private teacher/staff/student documents, photos, homework and study-material files.
# Unset or "none" → every upload returns 503 "Document storage is not configured".
# Only "local" is implemented. Use a private directory outside any public/static web
# root. On Render this must be on an attached persistent disk (e.g. /var/data/documents),
# otherwise files are lost on every restart and redeploy.
DOCUMENT_STORAGE_BACKEND=none
DOCUMENT_STORAGE_PATH=
DOCUMENT_MAX_IMAGE_BYTES=5242880
DOCUMENT_MAX_FILE_BYTES=10485760

# Super Admin platform backup artifacts (local directory). Empty → POST /backups returns 503.
# Full Neon pg_dump is not wired; creates metadata-only artifacts when set.
BACKUP_STORAGE_PATH=
BACKUP_RETENTION_DAYS=30
# Must be true to accept restore requests (still a safe no-op; never drops Neon).
ALLOW_BACKUP_RESTORE=false

# Transport GPS: optional expires_at on new GPS points (days). No auto-purge cron yet.
# GPS_RETENTION_DAYS=90
